# Copy to .env and adjust. Defaults run fully offline, no keys, no network.

AEGIS_PROTECTOR=mock        # mock | protegrity
AEGIS_EMBEDDER=hash         # hash | minilm  (minilm needs sentence-transformers)
AEGIS_LLM=mock              # mock | openai | anthropic
AEGIS_TOP_K=3

# AEGIS_LLM_MODEL=claude-sonnet-5
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Protegrity Developer Edition, fill once registration is approved:
# PROTEGRITY_ENDPOINT=...
# PROTEGRITY_API_KEY=...
