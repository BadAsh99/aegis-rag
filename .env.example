# Copy to .env and adjust. Defaults run fully offline, no keys, no network.

AEGIS_PROTECTOR=mock        # mock | protegrity
AEGIS_EMBEDDER=hash         # hash | minilm  (minilm needs sentence-transformers)
AEGIS_LLM=mock              # mock | openai | anthropic
AEGIS_TOP_K=3

# AEGIS_LLM_MODEL=claude-sonnet-5
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...

# Protegrity Developer Edition. Set BOTH of these to run the pipeline on real DE:
#   AEGIS_PROTECTOR=protegrity
#   AEGIS_PROTEGRITY_ENDPOINT=<your Developer Edition endpoint URL>
# The adapter (aegis/protection.py ProtegrityProtector) passes the endpoint to
# protegrity_developer_python.configure() and calls find_and_protect /
# find_and_unprotect. No separate API key variable is read.
# AEGIS_PROTEGRITY_ENDPOINT=...
